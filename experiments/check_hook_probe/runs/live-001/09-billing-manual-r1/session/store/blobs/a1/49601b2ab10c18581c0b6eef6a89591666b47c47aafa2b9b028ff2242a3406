TANDARD_SHIPPING_FEE = 15.0\n   21| \n   22| \n   23| def get_tax_rate(state: str) -> float:\n   24|     \"\"\"Returns state sales tax rate.\"\"\"\n   25|     return STATE_TAX_RATES.get(state.upper(), DEFAULT_TAX_RATE)\n   26| \n   27| \n   28| def calculate_volume_discount(subtotal: float) -> float:\n   29|     \"\"\"Applies tiered volume discount.\"\"\"\n   30|     if subtotal >= 500.0:\n   31|         return 0.10  # 10% off\n   32|     elif subtotal >= 300.0:\n   33|         return 0.05  # 5% off\n   34|     return 0.0\n   35| \n   36| \n   37| def calculate_shipping(subtotal: float) -> float:\n   38|     \"\"\"Free shipping over $150, otherwise flat fee.\"\"\"\n   39|     if subtotal >= FREE_SHIPPING_THRESHOLD:\n   40|         return 0.0\n   41|     return STANDARD_SHIPPING_FEE\n   42| \n   43| \n   44| def compute_discount_amount(\n   45|     subtotal: float,\n   46|     promo: Optional[PromoCode] = None\n   47| ) -> float:\n   48|     \"\"\"Calculates total discount dollars from volume or promo code.\"\"\"\n   49|     discount_pct = 0.0\n   50|     if promo and promo.is_eligible(subtotal):\n   51|         discount_pct = max(discount_pct, promo.discount_percent)\n   52|     else:\n   53|         discount_pct = max(discount_pct, calculate_volume_discount(subtotal))\n   54| \n   55|     return round(subtotal * discount_pct, 2)\n   56| \n   57| \n   58| def calculate_final_bill(\n   59|     cart: Cart,\n   60|     state: str,\n   61|     promo: Optional[PromoCode] = None\n   62| ) -> Dict[str, float]:\n   63|     \"\"\"Computes full breakdown: subtotal, discount, tax, shipping, final total.\n   64| \n   65|     Rule: Sales tax must only be assessed on the post-discount taxable amount.\n   66|     \"\"\"\n   67|     subtotal = cart.subtotal\n   68|     discount_amount = compute_discount_amount(subtotal, promo)\n   69|     discounted_subtotal = round(subtotal - discount_amount, 2)\n   70| \n   71|     tax_rate = get_tax_rate(state)\n   72| \n   73|     tax_amount = round(subtotal * tax_rate, 2)\n   74| \n   75|     shipping_fee = calculate_shipping(discounted_subtotal)\n   76|     final_total = round(discounted_subtotal + tax_amount + shipping_fee, 2)\n   77| \n   78|     return {\n   79|         \"subtotal\": subtotal,\n   80|         \"discount_amount\": discount_amount,\n   81|         \"taxable_amount\": discounted_subtotal,\n   82|         \"tax_amount\": tax_amount,\n   83|         \"shipping_fee\": shipping_fee,\n   84|         \"final_total\": final_total,\n   85|     }","role":"tool","tool_call_id":"call_P7qEdhEQ06KufgCd5GB4ZHfK"},{"content":null,"role":"assistant","tool_calls":[{"function":{"arguments":"{\"path\":\"checkout.py\"}","name":"read_file"},"id":"call_8VNFCE7gSt6Y5NNckKYriGtC","type":"function"},{"function":{"arguments":"{\"path\":\"models.py\"}","name":"read_file"},"id":"call_BArPDud5bAdoDwt0R1SPb7bl","type":"function"},{"function":{"arguments":"{\"path\":\"test_contract.py\"}","name":"read_file"},"id":"call_LcxbKGhGLXY519jI1It4j6GT","type":"function"}]},{"content":"checkout.py (lines 1-58 of 58)\n    1| \"\"\"Checkout pipeline service.\"\"\"\n    2| \n    3| from __future__ import annotations\n    4| \n    5| import uuid\n    6| from typing import Dict, Optional\n    7| from models import Cart, CartItem, OrderReceipt, PromoCode\n    8| from pricing import calculate_final_bill\n    9| \n   10| \n   11| class CheckoutService:\n   12|     def __init__(self, inventory: Optional[Dict[str, int]] = None):\n   13|         self.inventory = inventory if inventory is not None else {}\n   14|         self.orders_history: Dict[str, OrderReceipt] = {}\n   15| \n   16|     def validate_cart(self, cart: Cart) -> None:\n   17|         if not cart.items:\n   18|             raise ValueError(\"Cannot checkout an empty cart.\")\n   19|         \n   20|         for item in cart.items:\n   21|             if item.sku in self.inventory:\n   22|                 available = self.inventory[item.sku]\n   23|                 if available < item.quantity:\n   24|                     raise ValueError(\n   25|                         f\"Insufficient stock for SKU {item.sku}: requested {item.quantity}, available {available}.\"\n   26|                     )\n   27| \n   28|     def process_order(\n   29|         self,\n   30|         cart: Cart,\n   31|         state: str,\n   32|         promo: Optional[PromoCode] = None\n   33|     ) -> OrderReceipt:\n   34|         \"\"\"Runs validation, pricing, inventory deduction, and returns receipt.\"\"\"\n   35|         self.validate_cart(cart)\n   36|         \n   37|         bill = calculate_final_bill(cart=cart, state=state, promo=promo)\n   38|         \n   39|         # Deduct inventory\n   40|         for item in cart.items:\n   41|             if item.sku in self.inventory:\n   42|                 self.inventory[item.sku] -= item.quantity\n   43| \n   44|         order_id = f\"ORD-{uuid.uuid4().hex[:8].upper()}\"\n   45|         receipt = OrderReceipt(\n   46|             order_id=order_id,\n   47|             subtotal=bill[\"subtotal\"],\n   48|             discount_amount=bill[\"discount_amount\"],\n   49|             taxable_amount=bill[\"taxable_amount\"],\n   50|             tax_amount=bill[\"tax_amount\"],\n   51|             shipping_fee=bill[\"shipping_fee\"],\n   52|             final_total=bill[\"final_total\"],\n   53|             state=state,\n   54|             promo_code=promo.code if promo else None\n   55|         )\n   56| \n   57|         self.orders_history[order_id] = receipt\n   58|         return receipt","role":"tool","tool_call_id":"call_8VNFCE7gSt6Y5NNckKYriGtC"},{"content":"models.py (lines 1-57 of 57)\n    1| \"\"\"Data models for the billing and order processing system.\"\"\"\n    2| \n    3| from __future__ import annotations\n    4| \n    5| from dataclasses import dataclass, field\n    6| from typing import List, Optional\n    7| \n    8| \n    9| @dataclass\n   10| class CartItem:\n   11|     sku: str\n   12|     name: str\n   13|     unit_price: float\n   14|     quantity: int\n   15| \n   16|     @property\n   17|     def line_total(self) -> float:\n   18|         return round(self.unit_price * self.quantity, 2)\n   19| \n   20| \n   21| @dataclass\n   22| class PromoCode:\n   23|     code: str\n   24|     discount_percent: float\n   25|     min_subtotal: float = 0.0\n   26| \n   27|     def is_eligible(self, subtotal: float) -> bool:\n   28|         return subtotal >= self.min_subtotal\n   29| \n   30| \n   31| @dataclass\n   32| class Cart:\n   33|     items: List[CartItem] = field(default_factory=list)\n   34| \n   35|     @property\n   36|     def subtotal(self) -> float:\n   37|         return round(sum(item.line_total for item in self.items), 2)\n   38| \n   39|     @property\n   40|     def total_quantity(self) -> int:\n   41|         return sum(item.quantity for item in self.items)\n   42| \n   43|     def add_item(self, item: CartItem) -> None:\n   44|         self.items.append(item)\n   45| \n   46| \n   47| @dataclass\n   48| class OrderReceipt:\n   49|     order_id: str\n   50|     subtotal: float\n   51|     discount_amount: float\n   52|     taxable_amount: float\n   53|     tax_amount: float\n   54|     shipping_fee: float\n   55|     final_total: float\n   56|     state: str\n   57|     promo_code: Optional[str] = None","role":"tool","tool_call_id":"call_BArPDud5bAdoDwt0R1SPb7bl"},{"content":"test_contract.py (lines 1-82 of 82)\n    1| \"\"\"Comprehensive unit test suite for billing and checkout.\"\"\"\n    2| \n    3| import sys\n    4| from pathlib import Path\n    5| sys.path.insert(0, str(Path(__file__).parent))\n    6| \n    7| import unittest\n    8| from models import Cart, CartItem, PromoCode\n    9| from checkout import CheckoutService\n   10| \n   11| \n   12| class TestBillingPipeline(unittest.TestCase):\n   13|     def setUp(self):\n   14|         self.service = CheckoutService(inventory={\"SKU-1\": 100, \"SKU-2\": 50, \"SKU-3\": 20})\n   15| \n   16|     def test_empty_cart_fails_validation(self):\n   17|         cart = Cart()\n   18|         with self.assertRaises(ValueError):\n   19|             self.service.process_order(cart, state=\"CA\")\n   20| \n   21|     def test_standard_order_without_discounts(self):\n   22|         cart = Cart()\n   23|         cart.add_item(CartItem(sku=\"SKU-1\", name=\"Widget A\", unit_price=25.0, quantity=2)) # $50.00\n   24|         # State WA: tax 6.5% of 50.00 = 3.25. Shipping = 15.0. Total = 68.25\n   25|         receipt = self.service.process_order(cart, state=\"WA\")\n   26|         self.assertEqual(receipt.subtotal, 50.0)\n   27|         self.assertEqual(receipt.discount_amount, 0.0)\n   28|         self.assertEqual(receipt.tax_amount, 3.25)\n   29|         self.assertEqual(receipt.shipping_fee, 15.0)\n   30|         self.assertEqual(receipt.final_total, 68.25)\n   31| \n   32|     def test_tax_free_state(self):\n   33|         cart = Cart()\n   34|         cart.add_item(CartItem(sku=\"SKU-1\", name=\"Widget A\", unit_price=100.0, quantity=1)) # $100.00\n   35|         # Oregon (OR) has 0% tax. Shipping = 15.0. Total = 115.00\n   36|         receipt = self.service.process_order(cart, state=\"OR\")\n   37|         self.assertEqual(receipt.tax_amount, 0.0)\n   38|         self.assertEqual(receipt.final_total, 115.0)\n   39| \n   40|     def test_free_shipping_threshold(self):\n   41|         cart = Cart()\n   42|         cart.add_item(CartItem(sku=\"SKU-2\", name=\"Widget B\", unit_price=80.0, quantity=2)) # $160.00\n   43|         # Oregon: 0% tax. Free shipping threshold is $150. Shipping = 0. Total = 160.00\n   44|         receipt = self.service.process_order(cart, state=\"OR\")\n   45|         self.assertEqual(receipt.shipping_fee, 0.0)\n   46|         self.assertEqual(receipt.final_total, 160.0)\n   47| \n   48|     def test_insufficient_stock_fails(self):\n   49|         cart = Cart()\n   50|         cart.add_item(CartItem(sku=\"SKU-3\", name=\"Widget C\", unit_price=10.0, quantity=999))\n   51|         with self.assertRaises(ValueError):\n   52|             self.service.process_order(cart, state=\"DE\")\n   53| \n   54|     def test_promo_discount_with_california_tax(self):\n   55|         \"\"\"CRITICAL: Tax must be calculated on post-discount subtotal, not raw subtotal.\"\"\"\n   56|         cart = Cart()\n   57|         cart.add_item(CartItem(sku=\"SKU-1\", name=\"Widget A\", unit_price=50.0, quantity=4)) # $200.00\n   58|         promo = PromoCode(code=\"FALL20\", discount_percent=0.20, min_subtotal=100.0) # 20% off\n   59| \n   60|         # Subtotal: $200.00\n   61|         # Discount (20%): $40.00 -> Taxable: $160.00\n   62|         # CA Tax (8.25% of $160.00): $13.20\n   63|         # Shipping (Over $150): $0.00\n   64|         # Expected Total: 160.00 + 13.20 = $173.20\n   65|         receipt = self.service.process_order(cart, state=\"CA\", promo=promo)\n   66| \n   67|         self.assertEqual(receipt.discount_amount, 40.0)\n   68|         self.assertEqual(receipt.taxable_amount, 160.0)\n   69|         self.assertEqual(\n   70|             receipt.tax_amount,\n   71|             13.20,\n   72|             f\"Tax must be assessed on post-discount amount ($160 * 8.25% = $13.20). Got: {receipt.tax_amount}\"\n   73|         )\n   74|         self.assertEqual(\n   75|             receipt.final_total,\n   76|             173.20,\n   77|             f\"Final total mismatch: expected 173.20, got {receipt.final_total}\"\n   78|         )\n   79| \n   80| \n   81| if __name__ == \"__main__\":\n   82|     unittest.main()","role":"tool","tool_call_id":"call_LcxbKGhGLXY519jI1It4j6GT"}],"tools":[{"function":{"description":"Recursively list workspace-relative file paths that match a glob, in sorted order. The glob is matched against each file's relative path and against its file name, using Python fnmatch rules, case-sensitive: '*' and '?' also match '/', and '[abc]' matches one listed character. It never matches file contents. Cache and VCS directories (.git, __pycache__, .pytest_cache, .mypy_cache, .ruff_cache, .tox, .venv, node_modules) are skipped.","name":"glob_files","parameters":{"properties":{"glob":{"description":"Required. For example '*.py', 'tests/*', or 'setup.cfg'.","type":"string"},"path":{"description":"Directory (or single file) to list under, relative to the workspace root. Default '.'.","type":"string"}},"required":["glob"],"type":"object"}},"type":"function"},{"function":{"description":"Read a text file with 1-based line numbers. start_line and end_line are inclusive; omit start_line to begin at line 1 and end_line to read to the end. The header reports the range returned and the file's total lines. Long results are shown partially with an output id for paging.","name":"read_file","parameters":{"properties":{"end_line":{"type":"integer"},"path":{"type":"string"},"start_line":{"type":"integer"}},"required":["path"],"type":"object"}},"type":"function"},{"function":{"description":"List the classes and functions of a Python file with line numbers.","name":"outline","parameters":{"properties":{"path":{"type":"string"}},"required":["path"],"type":"object"}},"type":"function"},{"function":{"description":"Search case-sensitive literal text by default, or Python regex with regex=true. Returns one line per matching line as path:line: text, with 1-based line numbers; context_lines adds surrounding lines. file_glob only selects which files are searched.","name":"search_text","parameters":{"properties":{"context_lines":{"maximum":100,"minimum":0,"type":"integer"},"file_glob":{"description":"Optional glob selecting files by relative path or file name (same rules as glob_files), e.g. '*.py'. It never matches file contents. Default '*'.","type":"string"},"path":{"description":"File or directory to search, relative to the workspace root. Default '.'.","type":"string"},"query":{"description":"Required. Literal text, or a Python pattern when regex=true.","type":"string"},"regex":{"type":"b