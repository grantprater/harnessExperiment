d functions of a Python file with line numbers.","name":"outline","parameters":{"properties":{"path":{"type":"string"}},"required":["path"],"type":"object"}},"type":"function"},{"function":{"description":"Search case-sensitive literal text by default, or Python regex with regex=true. Returns one line per matching line as path:line: text, with 1-based line numbers; context_lines adds surrounding lines. file_glob only selects which files are searched.","name":"search_text","parameters":{"properties":{"context_lines":{"maximum":100,"minimum":0,"type":"integer"},"file_glob":{"description":"Optional glob selecting files by relative path or file name (same rules as glob_files), e.g. '*.py'. It never matches file contents. Default '*'.","type":"string"},"path":{"description":"File or directory to search, relative to the workspace root. Default '.'.","type":"string"},"query":{"description":"Required. Literal text, or a Python pattern when regex=true.","type":"string"},"regex":{"type":"boolean"}},"required":["query"],"type":"object"}},"type":"function"},{"function":{"description":"Replace literal text in a file, treating LF and CRLF line endings as equivalent. Preserve existing bytes outside the replacement and use local line endings for new_text. Other whitespace must match exactly. Fails without changing the file if old_text is absent, or if it occurs more than once while replace_all is false; set replace_all to replace every occurrence. Reports how many occurrences were replaced and shows the edited lines.","name":"replace_text","parameters":{"properties":{"new_text":{"type":"string"},"old_text":{"type":"string"},"path":{"type":"string"},"replace_all":{"type":"boolean"}},"required":["path","old_text","new_text"],"type":"object"}},"type":"function"},{"function":{"description":"Apply a single-file unified diff to an existing file. Exact line positions and context must match; all hunks are validated before writing. LF/CRLF differences are tolerated and local endings preserved. Supply path and patch (optional ---/+++ headers followed by @@ hunks). Use write_file to create files.","name":"apply_patch","parameters":{"properties":{"patch":{"type":"string"},"path":{"type":"string"}},"required":["path","patch"],"type":"object"}},"type":"function"},{"function":{"description":"Create a file, or overwrite it completely if it already exists, with the given content. Missing parent directories are created. Paths are relative to the workspace root.","name":"write_file","parameters":{"properties":{"content":{"type":"string"},"path":{"type":"string"}},"required":["path","content"],"type":"object"}},"type":"function"},{"function":{"description":"Read part of an earlier tool result by its output id (for example out_12). Results that were shown partially say which id and range to request. Give start_line/end_line, or start_byte/end_byte for very long lines.","name":"read_output","parameters":{"properties":{"end_byte":{"type":"integer"},"end_line":{"type":"integer"},"id":{"type":"string"},"start_byte":{"type":"integer"},"start_line":{"type":"integer"}},"required":["id"],"type":"object"}},"type":"function"},{"function":{"description":"Search an earlier output for literal text or optional Python regex, with surrounding context.","name":"search_output","parameters":{"properties":{"context_lines":{"maximum":100,"minimum":0,"type":"integer"},"id":{"type":"string"},"query":{"type":"string"},"regex":{"type":"boolean"}},"required":["id","query"],"type":"object"}},"type":"function"},{"function":{"description":"Declare the work complete. The final workspace is then checked independently.","name":"finish","parameters":{"properties":{"summary":{"type":"string"}},"required":["summary"],"type":"object"}},"type":"function"},{"function":{"description":"Run the fixed project tests. Full results are returned; this tool is available in all conditions.","name":"verify","parameters":{"properties":{},"required":[],"type":"object"}},"type":"function"}],"task_id":"billing-manua