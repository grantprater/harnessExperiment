{"created_at":"2026-10-03T22:06:35.070716Z","event_id":"evt_06382b17b85b4d5aa3f56bde04d6d64e","kind":"action_intent","operation_id":"tool-fa4f5458d7094184b5b68d4da94c7a0f","payload":{"action":"write_file","arguments":{"arguments":{"content":"\"\"\"In-memory Key-Value store engine with TTL and snapshot support.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport time\nfrom typing import Dict, Optional\nfrom models import KVEntry\n\n\nclass KVStore:\n    def __init__(self) -> None:\n        self._store: Dict[str, KVEntry] = {}\n\n    def set(self, key: str, value: str, ttl_seconds: Optional[float] = None) -> None:\n        \"\"\"Stores a key-value pair. If ttl_seconds is provided, sets expires_at to time.time() + ttl_seconds.\"\"\"\n        if ttl_seconds is not None:\n            self._store[key] = KVEntry(key, value, time.time() + ttl_seconds)\n        else:\n            self._store[key] = KVEntry(key, value)\n\n    def get(self, key: str) -> Optional[str]:\n        \"\"\"Returns the value for key. If key is missing or expired, removes it if expired and returns None.\"\"\"\n        if key not in self._store:\n            return None\n        entry = self._store[key]\n        if entry.is_expired():\n            del self._store[key]\n            return None\n        return entry.value\n\n    def delete(self, key: str) -> bool:\n        \"\"\"Deletes key from store. Returns True if deleted, False if key did not exist.\"\"\"\n        if key in self._store:\n            del self._store[key]\n            return True\n        return False\n\n    def export_json(self) -> str:\n        \"\"\"Returns a JSON string of all currently unexpired key -> value mappings.\"\"\"\n        unexpired = {k: v.value for k, v in self._store.items() if not v.is_expired()}\n        return json.dumps(unexpired)\n\n    def import_json(self, json_str: str) -> int:\n        \"\"\"Loads key -> value pairs from a JSON string into store. Returns count of loaded keys.\"\"\"\n        data = json.loads(json_str)\n        count = 0\n        for key, value in data.items():\n            self.set(key, value)\n            count += 1\n        return count\n","path":"engine.py"},"call_id":"control_0"},"workspace_revision_at_intent":"sha256:e9b852b5e7829e262e9cd1ed0429c6198bbac335cacad4f70d7f3ae6bbe6857b"},"schema_version":1,"sequence":14}
