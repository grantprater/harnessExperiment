d. Supply path and patch (optional ---/+++ headers followed by @@ hunks). Use write_file to create files.","name":"apply_patch","parameters":{"properties":{"patch":{"type":"string"},"path":{"type":"string"}},"required":["path","patch"],"type":"object"}},"type":"function"},{"function":{"description":"Create a file, or overwrite it completely if it already exists, with the given content. Missing parent directories are created. Paths are relative to the workspace root.","name":"write_file","parameters":{"properties":{"content":{"type":"string"},"path":{"type":"string"}},"required":["path","content"],"type":"object"}},"type":"function"},{"function":{"description":"Read part of an earlier tool result by its output id (for example out_12). Results that were shown partially say which id and range to request. Give start_line/end_line, or start_byte/end_byte for very long lines.","name":"read_output","parameters":{"properties":{"end_byte":{"type":"integer"},"end_line":{"type":"integer"},"id":{"type":"string"},"start_byte":{"type":"integer"},"start_line":{"type":"integer"}},"required":["id"],"type":"object"}},"type":"function"},{"function":{"description":"Search an earlier output for literal text or optional Python regex, with surrounding context.","name":"search_output","parameters":{"properties":{"context_lines":{"maximum":100,"minimum":0,"type":"integer"},"id":{"type":"string"},"query":{"type":"string"},"regex":{"type":"boolean"}},"required":["id","query"],"type":"object"}},"type":"function"},{"function":{"description":"Declare the work complete. The final workspace is then checked independently.","name":"finish","parameters":{"properties":{"summary":{"type":"string"}},"required":["summary"],"type":"object"}},"type":"function"},{"function":{"description":"Run the fixed project tests. Full results are returned; this tool is available in all conditions.","name":"verify","parameters":{"properties":{},"required":[],"type":"object"}},"type":"function"}],"task_id":"pagination-ma