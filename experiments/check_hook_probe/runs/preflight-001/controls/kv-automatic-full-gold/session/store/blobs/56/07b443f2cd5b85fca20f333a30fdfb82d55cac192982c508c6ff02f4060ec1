elf._store[key] = KVEntry(key, value, time.time() + ttl_seconds)\\n        else:\\n            self._store[key] = KVEntry(key, value)\\n\\n    def get(self, key: str) -> Optional[str]:\\n        \\\"\\\"\\\"Returns the value for key. If key is missing or expired, removes it if expired and returns None.\\\"\\\"\\\"\\n        if key not in self._store:\\n            return None\\n        entry = self._store[key]\\n        if entry.is_expired():\\n            del self._store[key]\\n            return None\\n        return entry.value\\n\\n    def delete(self, key: str) -> bool:\\n        \\\"\\\"\\\"Deletes key from store. Returns True if deleted, False if key did not exist.\\\"\\\"\\\"\\n        if key in self._store:\\n            del self._store[key]\\n            return True\\n        return False\\n\\n    def export_json(self) -> str:\\n        \\\"\\\"\\\"Returns a JSON string of all currently unexpired key -> value mappings.\\\"\\\"\\\"\\n        unexpired = {k: v.value for k, v in self._store.items() if not v.is_expired()}\\n        return json.dumps(unexpired)\\n\\n    def import_json(self, json_str: str) -> int:\\n        \\\"\\\"\\\"Loads key -> value pairs from a JSON string into store. Returns count of loaded keys.\\\"\\\"\\\"\\n        data = json.loads(json_str)\\n        count = 0\\n        for key, value in data.items():\\n            self.set(key, value)\\n            count += 1\\n        return count\\n\"}","name":"write_file"},"id":"control_0","type":"function"}]},{"content":"Overwrote engine.py (1837 bytes, 51 lines).\nCheck failed; tests=5; source=5e622f916902; full evidence=out_2.\ntest_basic_set_and_get (test_contract.TestKVStore.test_basic_set_and_get) ... ERROR\ntest_delete_key (test_contract.TestKVStore.test_delete_key) ... ok\ntest_json_export_and_import (test_contract.TestKVStore.test_json_export_and_import) ... ERROR\ntest_models_is_expired_method (test_contract.TestKVStore.test_models_is_expired_method) ... ERROR\ntest_ttl_expiration (tes