+import sqlparse
+
+sql = """
+CREATE OR REPLACE FUNCTION testfunc(input1 INT) RETURNS INT AS $$
+DECLARE
+BEGIN
+  IF input1 = 0 THEN
+    RETURN 0;
+  END IF;
+  RETURN 1;
+END;
+$$ LANGUAGE plpgsql;
+"""
+stmts = sqlparse.split(sql)
+print(len(stmts))
+for s in stmts:
+    print('---')
+    print(s)
+
+sql2 = """
+BEGIN
+  FOR i IN 1..10 LOOP
+    IF i = 5 THEN
+      CONTINUE;
+    END IF;
+  END LOOP;
+END;
+"""
+stmts2 = sqlparse.split(sql2)
+print(len(stmts2))
+for s in stmts2:
+    print('===')
+    print(s)
