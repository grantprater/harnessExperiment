  "instructions": "You are working in a source checkout of {repo} ({repo_url}) at an upstream commit. The following problem was reported:\n\n{statement}\n\nChange the library so the reported behavior is correct. Hidden upstream tests will be run on your final workspace; tests you add or edit are not used for acceptance, but you may write and run tests to check your work (for example `pytest tests/test_example.py -q` with the run tool). Call finish when you are done.",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "glob_files",
        "description": "Recursively list workspace-relative file paths that match a glob, in sorted order. The glob is matched against each file's relative path and against its file name, using Python fnmatch rules, case-sensitive: '*' and '?' also match '/', and '[abc]' matches one listed character. It never matches file contents. Cache and VCS directories (.git, __pycache__, .pytest_cache, .mypy_cache, .ruff_cache, .tox, .venv, node_modules) are skipped.",
        "parameters": {
          "type": "object",
          "properties": {
            "glob": {
              "type": "string",
              "description": "Required. For example '*.py', 'tests/*', or 'setup.cfg'."
            },
            "path": {
              "type": "string",
              "description": "Directory (or single file) to list under, relative to the workspace root. Default '.'."
            }
          },
          "required": [
            "glob"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "read_file",
        "description": "Read a text file with 1-based line numbers. start_line and end_line are inclusive; omit start_line to begin at line 1 and end_line to read to the end. The header reports the range returned and the file's total lines. Long results are shown partially with an output id for paging.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "start_line": {
              "type": "integer"
            },
            "end_line": {
              "type": "integer"
            }
          },
          "required": [
            "path"
          ]
        }
      }
    },
