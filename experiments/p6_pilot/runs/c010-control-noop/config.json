    },
    {
      "type": "function",
      "function": {
        "name": "search_text",
        "description": "Search file contents for exact text (literal characters, case-sensitive; not a regex). Returns one line per match as path:line: text, with 1-based line numbers, and states the scope searched. file_glob only selects which files are searched.",
